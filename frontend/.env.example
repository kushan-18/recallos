# ===========================================================================
# AI Customer Support frontend - environment variables (Vite)
# ===========================================================================
# Vite only exposes variables that start with VITE_ to browser code.
# Copy this file to ".env" and adjust if needed.
# ===========================================================================

# Base URL for API calls.
#
# Development (default): the Vite dev-server proxy forwards "/api" to the
# backend (see vite.config.js), so the relative default just works.
#
# Production (Netlify): set this in the Netlify dashboard under
# Site settings → Environment variables → VITE_API_BASE_URL
# to your Render backend URL, e.g.:
#   VITE_API_BASE_URL=https://your-app.onrender.com/api
VITE_API_BASE_URL=/api
