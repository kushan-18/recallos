# ===========================================================================
# RecallOS frontend — environment variables (Vite)
# ===========================================================================
# Vite only exposes variables that start with VITE_ to browser code.
# Copy this file to ".env" and adjust if needed.
# ===========================================================================

# Base URL for API calls. In development the Vite proxy forwards "/api"
# to the backend (see vite.config.js), so the default just works.
VITE_API_BASE_URL=/api
