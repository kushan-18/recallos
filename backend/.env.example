# ===========================================================================
# AI Customer Support backend — environment variables
# ===========================================================================
# HOW TO USE THIS FILE:
#   1. Make a copy named ".env":   copy .env.example .env
#   2. Put your REAL keys only in ".env" (never in code, never in Git).
#   3. ".env" is in .gitignore, so Git ignores it automatically.
# ===========================================================================

# --- Server ----------------------------------------------------------------
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# In production, add your Netlify URL (comma-separated):
# CORS_ORIGIN=http://localhost:5173,https://your-site.netlify.app

# --- AI (Gemini) -----------------------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: second key used automatically if the primary hits a 429 quota error.
GEMINI_API_KEY_BACKUP=
# Model used for chat replies and memory extraction
GEMINI_MODEL=gemini-3.5-flash
# Model used to turn text into embedding vectors
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Dimensions of that embedding model (gemini-embedding-001 = 3072)
EMBEDDING_DIM=3072

# --- MongoDB Atlas ---------------------------------------------------------
# Your cluster connection string (Atlas -> Connect -> Drivers)
MONGODB_URI=your-mongodb-atlas-connection-string
